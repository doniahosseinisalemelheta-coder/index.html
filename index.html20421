<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>شهادة إتمام تحدي الكنز المفقود</title>
<style>
:root{--brown:#24150e;--brown2:#3b2415;--gold:#d9ad4b;--cream:#f8edcf;--ink:#4a2b16}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;font-family:Tahoma,Arial,sans-serif;background:radial-gradient(circle at 50% 0%,#62401f 0,#24170f 48%,#120d09 100%);color:#fff4d8;display:flex;align-items:center;justify-content:center;padding:28px}
.wrap{width:min(100%,1050px);text-align:center}
.top{margin-bottom:22px}.top h1{font-size:clamp(24px,4vw,38px);color:#f0c96d;margin:0 0 8px;text-shadow:0 3px 15px #000}.top p{margin:0;color:#e5d1a4;font-size:15px}
.panel{background:rgba(28,18,12,.82);border:1px solid rgba(225,181,83,.45);border-radius:22px;padding:22px;box-shadow:0 20px 60px #0008}
.controls{display:flex;gap:12px;justify-content:center;align-items:center;flex-wrap:wrap;margin-bottom:20px}
input{width:min(100%,390px);padding:14px 17px;border-radius:12px;border:2px solid #c89b42;background:#fff8e8;color:#3c2414;font:18px Tahoma;text-align:center;outline:none}
button{border:0;border-radius:12px;padding:14px 22px;font: bold 16px Tahoma;cursor:pointer;transition:.2s}
button:hover{transform:translateY(-2px);filter:brightness(1.08)}
.primary{background:linear-gradient(135deg,#ffe7a0,#c58b27);color:#3c230e;box-shadow:0 6px 18px #0005}
.secondary{background:#5b3820;color:#ffe8b0;border:1px solid #bd9144}
.hint{color:#d9c69f;font-size:13px;margin:12px 0 0}
.certificate{position:relative;overflow:hidden;aspect-ratio:1.455;background:linear-gradient(135deg,#f8edcf,#e8d09a 55%,#f7e9c4);color:var(--ink);padding:clamp(12px,3vw,34px);border:clamp(6px,1vw,12px) double #9b6825;box-shadow:inset 0 0 0 5px #f9e8b4,inset 0 0 0 9px #a97931;}
.certificate:before,.certificate:after{content:"✦　❖　✦";position:absolute;color:#a9772e;font-size:clamp(12px,2vw,23px);letter-spacing:5px;opacity:.85}.certificate:before{top:15px;right:22px}.certificate:after{bottom:15px;left:22px}
.inner{height:100%;border:1px solid rgba(135,85,30,.55);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2.5% 5%;position:relative}
.kicker{font-size:clamp(11px,1.5vw,18px);letter-spacing:2px;color:#80501e;font-weight:bold}
.treasure{font-size:clamp(28px,5vw,58px);line-height:1.1;margin:5px 0;color:#74451d;text-shadow:1px 2px #fff2c8}
.title{font-size:clamp(24px,4.1vw,48px);font-weight:900;color:#5a3518;margin:0 0 12px}
.copy{font-size:clamp(12px,1.75vw,20px);line-height:1.9;margin:0;max-width:850px}
.student{min-width:42%;max-width:90%;font-size:clamp(20px,3.3vw,38px);font-weight:bold;color:#8b5a20;border-bottom:2px solid #a97732;padding:4px 24px 8px;margin:8px auto 10px;overflow-wrap:anywhere}
.footer{display:flex;justify-content:space-between;align-items:end;width:85%;margin-top:clamp(10px,2vw,22px);font-size:clamp(10px,1.4vw,16px);color:#775027}
.seal{position:absolute;left:5%;top:7%;width:clamp(55px,8vw,95px);height:clamp(55px,8vw,95px);border:3px solid #b48232;border-radius:50%;display:grid;place-items:center;color:#98621f;font-size:clamp(23px,3vw,34px);transform:rotate(-12deg);background:#f5e2b2aa}
@media(max-width:600px){body{padding:14px}.panel{padding:12px}.certificate{aspect-ratio:1.05}.inner{padding:8% 4%}.seal{left:4%;top:4%}.footer{width:94%}.copy{line-height:1.65}}
@media print{body{background:white;padding:0}.top,.controls,.hint{display:none!important}.wrap,.panel{width:100%;padding:0;border:0;box-shadow:none;background:none}.certificate{width:100vw;height:68.7vw;max-height:100vh}}
</style>
</head>
<body>
<div class="wrap">
  <header class="top"><h1>🏆 شهادة أبطال الكنز 🏆</h1><p>اكتب اسمك واحتفظ بشهادة إنجازك بعد إكمال التحدي للنهاية</p></header>
  <main class="panel">
    <div class="controls">
      <input id="studentName" type="text" maxlength="35" placeholder="اكتب اسمك هنا" autocomplete="name" aria-label="اسم الطالب">
      <button class="primary" id="updateBtn">اعرض شهادتي ✨</button>
      <button class="secondary" id="downloadBtn">تحميل الشهادة ⬇</button>
    </div>
    <section class="certificate" id="certificate" aria-label="معاينة شهادة التقدير">
      <div class="inner">
        <div class="seal">♛</div>
        <div class="kicker">رحلة البحث عن الكنز • ELKHETA</div>
        <div class="treasure">💰 ✦ 🗝️ ✦ 💰</div>
        <h2 class="title">شهادة تقدير</h2>
        <p class="copy">تُمنح هذه الشهادة إلى البطل / البطلة</p>
        <div class="student" id="namePreview">اسم البطل</div>
        <p class="copy">تقديرًا لمجهوده وإصراره، ووصوله إلى نهاية<br> <strong>تحدي الكنز المفقود</strong> وإتمام جميع مراحله للنهاية.<br>أحسنت! كل خطوة كانت دليلًا على عزيمتك وروح التحدي 🏆</p>
        <div class="footer"><span>منصة الخطة التعليمية</span><span>🏅 بطل الكنز المفقود</span></div>
      </div>
    </section>
    <p class="hint">اكتب الاسم ثم اضغط «اعرض شهادتي»، وبعدها حمّل الشهادة كصورة PNG.</p>
  </main>
</div>
<script>
const input=document.getElementById('studentName');
const preview=document.getElementById('namePreview');
function updateName(){const value=input.value.trim();preview.textContent=value||'اسم البطل';}
document.getElementById('updateBtn').addEventListener('click',updateName);
input.addEventListener('input',updateName);
function roundedRect(ctx,x,y,w,h,r){ctx.beginPath();ctx.roundRect(x,y,w,h,r);}
function drawCertificate(name){
 const c=document.createElement('canvas');c.width=1600;c.height=1100;const x=c.getContext('2d');
 const bg=x.createLinearGradient(0,0,1600,1100);bg.addColorStop(0,'#fff3d4');bg.addColorStop(.55,'#ead19b');bg.addColorStop(1,'#f8edcf');x.fillStyle=bg;x.fillRect(0,0,1600,1100);
 x.strokeStyle='#8e5d22';x.lineWidth=18;x.strokeRect(28,28,1544,1044);x.strokeStyle='#d0a24b';x.lineWidth=5;x.strokeRect(52,52,1496,996);x.strokeStyle='#a87935';x.lineWidth=2;x.strokeRect(76,76,1448,948);
 // Decorative corner motifs
 x.fillStyle='#a87935';x.font='bold 48px Tahoma';x.textAlign='center';['✦ ❖ ✦','✦ ❖ ✦','✦ ❖ ✦','✦ ❖ ✦'].forEach((t,i)=>x.fillText(t,i%2?1480:120,i<2?125:1000));
 // seal
 x.save();x.translate(1390,215);x.rotate(-.18);x.beginPath();x.arc(0,0,72,0,Math.PI*2);x.fillStyle='#f2dfb1';x.fill();x.lineWidth=7;x.strokeStyle='#a87935';x.stroke();x.fillStyle='#94601f';x.font='72px Tahoma';x.fillText('♛',0,24);x.restore();
 x.fillStyle='#80501e';x.font='bold 32px Tahoma';x.fillText('رحلة البحث عن الكنز • ELKHETA',800,185);
 x.font='70px Tahoma';x.fillText('💰  ✦  🗝️  ✦  💰',800,285);
 x.fillStyle='#5a3518';x.font='bold 92px Tahoma';x.fillText('شهادة تقدير',800,410);
 x.fillStyle='#68421f';x.font='42px Tahoma';x.fillText('تُمنح هذه الشهادة إلى البطل / البطلة',800,505);
 x.fillStyle='#8b5a20';x.font='bold 66px Tahoma';x.fillText(name||'اسم البطل',800,620);x.strokeStyle='#a97732';x.lineWidth=3;x.beginPath();x.moveTo(400,650);x.lineTo(1200,650);x.stroke();
 x.fillStyle='#4a2b16';x.font='38px Tahoma';x.fillText('تقديرًا لمجهوده وإصراره، ووصوله إلى نهاية',800,730);x.font='bold 43px Tahoma';x.fillText('تحدي الكنز المفقود',800,795);x.font='36px Tahoma';x.fillText('وإتمام جميع مراحله للنهاية. أحسنت! كل خطوة كانت دليلًا على عزيمتك وروح التحدي',800,855);
 x.fillStyle='#775027';x.font='bold 30px Tahoma';x.textAlign='right';x.fillText('منصة الخطة التعليمية',1370,965);x.textAlign='left';x.fillText('🏅 بطل الكنز المفقود',230,965);
 return c;
}
document.getElementById('downloadBtn').addEventListener('click',()=>{updateName();const name=input.value.trim();if(!name){input.focus();alert('اكتب اسمك الأول علشان نجهز شهادتك!');return;}const canvas=drawCertificate(name);const a=document.createElement('a');a.download='شهادة-تحدي-الكنز-المفقود.png';a.href=canvas.toDataURL('image/png');a.click();});
</script>
</body>
</html>
